{
  "name": "tz-event-timer",
  "version": "1.0.0",
  "description": "A web based event timer to show time in visitors time zone.",
  "main": "index.html",
  "scripts": {
    "build": "webpack --config webpack.dev.js",
    "prod": "webpack --config webpack.prod.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.cjs",
    "test:browser": "playwright test",
    "check": "npm run test:unit && npm run prod && npm run test:browser"
  },
  "author": "Matthew Craig",
  "license": "MIT",
  "dependencies": {
    "flatpickr": "^4.6.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "css-loader": "^6.7.1",
    "html-webpack-plugin": "^5.5.0",
    "jsdom": "^31.0.0",
    "nodemon": "^2.0.15",
    "style-loader": "^3.3.1",
    "webpack": "^5.71.0",
    "webpack-cli": "^4.9.2"
  },
  "engines": {
    "node": ">=24"
  }
}
